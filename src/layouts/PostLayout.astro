---
import 'katex/dist/katex.min.css'

import BaseLayout from './BaseLayout.astro'
import TOC from '../components/TOC.astro'
import Comments from '../components/Comments.astro'
import MermaidRuntime from '../components/MermaidRuntime.astro'
import type { Post } from '../lib/posts'
import { formatDate } from '../lib/posts'
import type { Heading } from '../lib/htmlPost'
import { postUrl, tagUrl } from '../lib/url'

interface Props {
  post: Post
  /** md 来自 render()，html 来自 extractHeadings()，结构一致 */
  headings: Heading[]
  prev?: Post
  next?: Post
}

const { post, headings, prev, next } = Astro.props
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  publishedTime={post.pubDate}
  modifiedTime={post.updatedDate}
  narrow={false}
>
  <div class="post-layout">
    {/* 有了 data-pagefind-body，Pagefind 只索引文章页，列表页不再污染搜索结果 */}
    <article data-pagefind-body>
      <header class="post-header">
        <h1>{post.title}</h1>
        <div class="post-meta">
          <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
          {post.updatedDate && <span>更新于 {formatDate(post.updatedDate)}</span>}
          <span>{post.words} 字</span>
          <span>约 {post.minutes} 分钟</span>
          {post.format === 'html' && <span class="format-badge" title="这篇文章直接以 HTML 写成">html</span>}
          {post.tags.map((tag) => <a class="tag-link" href={tagUrl(tag)}>{tag}</a>)}
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      {
        (prev || next) && (
          <nav class="post-nav" aria-label="上一篇 / 下一篇" data-pagefind-ignore>
            {prev ? (
              <a href={postUrl(prev.slug)}>
                <span class="label">上一篇</span>
                {prev.title}
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="post-nav__next" href={postUrl(next.slug)}>
                <span class="label">下一篇</span>
                {next.title}
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }

      <Comments />
    </article>

    <TOC headings={headings} />
  </div>

  <MermaidRuntime />
</BaseLayout>

<script>
  // 代码块复制按钮 + 宽表格滚动容器。
  // 两者都是对渲染好的 HTML 做增强，md 与 html 两类文章一视同仁。
  const prose = document.querySelector('.prose')

  if (prose) {
    for (const pre of prose.querySelectorAll<HTMLPreElement>('pre')) {
      const wrapper = document.createElement('div')
      wrapper.className = 'code-block'
      pre.parentNode?.insertBefore(wrapper, pre)
      wrapper.appendChild(pre)

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'code-copy'
      button.textContent = '复制'
      button.setAttribute('aria-label', '复制代码')

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText)
          button.textContent = '已复制'
          button.dataset.copied = 'true'
        } catch {
          button.textContent = '复制失败'
        }
        setTimeout(() => {
          button.textContent = '复制'
          delete button.dataset.copied
        }, 1600)
      })

      wrapper.appendChild(button)
    }

    // 宽表格必须在自己的容器里横向滚动，否则会把整页撑出横向滚动条
    for (const table of prose.querySelectorAll('table')) {
      if (table.parentElement?.classList.contains('table-scroll')) continue
      const scroll = document.createElement('div')
      scroll.className = 'table-scroll'
      table.parentNode?.insertBefore(scroll, table)
      scroll.appendChild(table)
    }
  }
</script>
