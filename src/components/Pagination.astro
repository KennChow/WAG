---
import { withBase } from '../lib/url'

interface Props {
  currentPage: number
  lastPage: number
  prevUrl?: string
  nextUrl?: string
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props
---

{
  lastPage > 1 && (
    <nav class="pagination" aria-label="分页">
      {prevUrl ? <a href={withBase(prevUrl)}>← 上一页</a> : <span />}
      <span class="pagination__status">
        第 {currentPage} / {lastPage} 页
      </span>
      {nextUrl ? <a href={withBase(nextUrl)}>下一页 →</a> : <span />}
    </nav>
  )
}
