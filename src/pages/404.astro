---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/url'
---

<BaseLayout title="页面不存在" description="没有找到这个页面。">
  <div class="notfound">
    <p class="notfound__code">404</p>
    <h1 class="page-title">没有找到这个页面</h1>
    <p class="page-lead">
      链接可能已经失效，或者地址输错了。
    </p>
    <p>
      <a href={withBase('/')}>回到首页</a> · <a href={withBase('/posts/')}>浏览全部文章</a> ·
      <a href={withBase('/search/')}>搜索</a>
    </p>
  </div>
</BaseLayout>
