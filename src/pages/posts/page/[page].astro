---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostCard from '../../../components/PostCard.astro'
import Pagination from '../../../components/Pagination.astro'
import { getAllPosts, pageSlice } from '../../../lib/posts'
import { SITE } from '../../../site.config.mjs'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  const lastPage = Math.max(1, Math.ceil(posts.length / SITE.postsPerPage))

  // 第 1 页在 /posts/，这里只生成第 2 页往后
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }))
}

const posts = await getAllPosts()
const page = pageSlice(posts, Number(Astro.params.page), SITE.postsPerPage)
---

<BaseLayout title={`全部文章 · 第 ${page.currentPage} 页`} description={`${SITE.title} 的全部文章。`}>
  <h1 class="page-title">全部文章</h1>
  <p class="page-lead">共 {posts.length} 篇</p>

  <ul class="post-list">
    {page.posts.map((post) => <PostCard post={post} />)}
  </ul>

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.prevUrl}
    nextUrl={page.nextUrl}
  />
</BaseLayout>
