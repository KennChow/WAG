---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import Pagination from '../../components/Pagination.astro'
import { getAllPosts, pageSlice } from '../../lib/posts'
import { SITE } from '../../site.config.mjs'

const posts = await getAllPosts()
const page = pageSlice(posts, 1, SITE.postsPerPage)
---

<BaseLayout title="全部文章" description={`${SITE.title} 的全部文章，共 ${posts.length} 篇。`}>
  <h1 class="page-title">全部文章</h1>
  <p class="page-lead">共 {posts.length} 篇</p>

  <ul class="post-list">
    {page.posts.map((post) => <PostCard post={post} />)}
  </ul>

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.prevUrl}
    nextUrl={page.nextUrl}
  />
</BaseLayout>
