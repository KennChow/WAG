---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getAllPosts, groupByYear, formatDate } from '../lib/posts'
import { postUrl } from '../lib/url'

const posts = await getAllPosts()
const years = groupByYear(posts)
---

<BaseLayout title="归档" description={`按年份浏览全部 ${posts.length} 篇文章。`}>
  <h1 class="page-title">归档</h1>
  <p class="page-lead">共 {posts.length} 篇</p>

  {
    years.map(({ year, posts: yearPosts }) => (
      <section>
        <h2 class="archive-year">
          {year} <span class="count">· {yearPosts.length} 篇</span>
        </h2>
        <ul class="archive-list">
          {yearPosts.map((post) => (
            <li class="archive-item">
              <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
              <a href={postUrl(post.slug)}>{post.title}</a>
              {post.format === 'html' && <span class="format-badge">html</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
